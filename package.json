{
  "name": "globey-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Globey Atlas: geography games for young explorers. Website, Android app and iOS app from one codebase.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#FBC94A' --splashBackgroundColor '#E4F1F4' --splashBackgroundColorDark '#0A1C27'",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "serve": "python3 -m http.server 8000 --directory www"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
